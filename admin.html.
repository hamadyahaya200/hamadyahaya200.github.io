
<!DOCTYPE html>
<html lang="sw">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Admin Dashboard | Hamad Yahaya</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#f2f5fa;color:#17243a}
.container{max-width:850px;margin:50px auto;padding:20px}
.panel{background:white;padding:28px;border-radius:14px;box-shadow:0 5px 25px #0000000d}
h1{color:#12345a}
input,textarea,select{width:100%;padding:13px;margin:8px 0 16px;border:1px solid #ccd5e0;border-radius:7px;font-size:15px}
textarea{min-height:130px;resize:vertical}
button{background:#123e69;color:white;border:0;padding:13px 20px;border-radius:7px;cursor:pointer}
button:hover{background:#205b91}
.hidden{display:none}
.status{margin:12px 0;color:#17643b}
.logout{background:#9b3030;float:right}
</style>
</head>
<body>
<div class="container">

<div class="panel" id="login">
<h1>Hamad Yahaya</h1>
<p>Admin Dashboard – Ingia kwenye akaunti yako</p>
<form id="loginForm">
<label>Email</label>
<input type="email" id="email" required>
<label>Password</label>
<input type="password" id="password" required>
<button type="submit">Ingia</button>
</form>
<p id="loginMessage"></p>
</div>

<div class="panel hidden" id="dashboard">
<button class="logout" id="logout">Toka</button>
<h1>Admin Dashboard</h1>
<p>Karibu. Simamia maudhui ya tovuti yako hapa.</p>

<form id="contentForm">
<label>Sehemu ya tovuti</label>
<select id="section">
<option value="about">Kuhusu Mwandishi</option>
<option value="literature">Fasihi na Kazi Zangu</option>
<option value="procurement">Taaluma ya Procurement</option>
<option value="contact">Mawasiliano</option>
</select>

<label>Lugha</label>
<select id="language">
<option value="sw">Kiswahili</option>
<option value="en">English</option>
</select>

<label>Kichwa</label>
<input type="text" id="title" placeholder="Andika kichwa">

<label>Maudhui</label>
<textarea id="content" placeholder="Andika maudhui hapa..."></textarea>

<button type="submit">Hifadhi Maudhui</button>
</form>
<p id="saveMessage"></p>

<hr>
<h3>Maudhui yaliyohifadhiwa</h3>
<div id="contentList">Inapakia...</div>
</div>
</div>

<script>
const SUPABASE_URL = "https://xkcrotlghwhgjuinnxzp.supabase.co";
const SUPABASE_KEY = "sb_publishable_CUnSD1LeO9qSEWvtjuyjyg_ewheu1FQ";

const db = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

const loginBox = document.getElementById("login");
const dashboard = document.getElementById("dashboard");

async function checkSession(){
  const {data} = await db.auth.getSession();
  if(data.session){
    loginBox.classList.add("hidden");
    dashboard.classList.remove("hidden");
    loadContent();
  }
}

document.getElementById("loginForm").addEventListener("submit",async(e)=>{
  e.preventDefault();
  const email=document.getElementById("email").value;
  const password=document.getElementById("password").value;

  const {error}=await db.auth.signInWithPassword({email,password});

  if(error){
    document.getElementById("loginMessage").textContent=error.message;
  }else{
    document.getElementById("loginMessage").textContent="Umefanikiwa kuingia.";
    checkSession();
  }
});

document.getElementById("logout").addEventListener("click",async()=>{
  await db.auth.signOut();
  location.reload();
});

document.getElementById("contentForm").addEventListener("submit",async(e)=>{
  e.preventDefault();

  const record={
    section:document.getElementById("section").value,
    language:document.getElementById("language").value,
    title:document.getElementById("title").value,
    content:document.getElementById("content").value
  };

  const {error}=await db.from("site_content").insert(record);

  document.getElementById("saveMessage").textContent=
    error ? error.message : "Maudhui yamehifadhiwa kikamilifu.";

  if(!error){
    document.getElementById("contentForm").reset();
    loadContent();
  }
});

async function loadContent(){
  const {data,error}=await db.from("site_content")
    .select("*").order("created_at",{ascending:false});

  const list=document.getElementById("contentList");

  if(error){
    list.textContent=error.message;
    return;
  }

  list.innerHTML="";

  data.forEach(item=>{
    const card=document.createElement("div");
    card.style.cssText="border-bottom:1px solid #ddd;padding:12px 0";

    const heading=document.createElement("strong");
    heading.textContent=item.section+" ("+item.language+") – "+(item.title||"");

    const paragraph=document.createElement("p");
    paragraph.textContent=item.content||"";

    card.append(heading,paragraph);
    list.appendChild(card);
  });

  if(data.length===0) list.textContent="Bado hakuna maudhui.";
}

checkSession();
</script>
</body>
</html>
